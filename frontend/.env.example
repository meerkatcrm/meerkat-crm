# Dev server port
PORT=7300

# Backend URL (API Server)
# Required for local dev (the dev server doesn't proxy)
# Leave empty for Docker: the Go server serves the bundle and the API on one origin
REACT_APP_API_URL=http://localhost:8080

# Request Timeout (in milliseconds)
# Default: 30000 (30 seconds)
REACT_APP_REQUEST_TIMEOUT=30000
